# Database Configuration
# Local SQLite for immediate out-of-the-box demo & testing:
DATABASE_URL=sqlite:///./demo.db
# Or PostgreSQL + PostGIS (Production target / Docker Compose):
# DATABASE_URL=postgresql+psycopg://swm_ics:change_me_for_local_development@localhost:5432/swm_ics

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_DB=swm_ics
POSTGRES_USER=swm_ics
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# FastAPI Server
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# MQTT Broker & Worker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT_PATH=
MQTT_CLIENT_ID=swm-ics-worker-local
MQTT_TELEMETRY_TOPIC_TEMPLATE=smartwaste/device/{device_id}/telemetry
MQTT_STATUS_TOPIC_TEMPLATE=smartwaste/device/{device_id}/status
MQTT_CONFIG_TOPIC_TEMPLATE=smartwaste/device/{device_id}/config
MQTT_ACK_TOPIC_TEMPLATE=smartwaste/device/{device_id}/ack

# Authentication (Firebase Admin)
FIREBASE_PROJECT_ID=

# External Services & Routing
OSRM_BASE_URL=https://router.project-osrm.org
OTP_DEMO_MODE=false
